      "parameters": {
        "chatId": "5443630474",
        "text": "=🔥 <b>Hot Lead!</b>\n\n<b>Name:</b> {{ $('Extract Lead Fields').item.json.name }}\n<b>Company:</b> {{ $('Extract Lead Fields').item.json.company }}\n<b>Email:</b> {{ $('Extract Lead Fields').item.json.email }}\n<b>Message:</b> {{ $('Extract Lead Fields').item.json.message }}\n\n<b>Why hot:</b> {{ $('Score Lead').item.json.output.reasoning }}\n\n<b>Suggested reply:</b>\n{{ $('Draft Hot Lead Reply').item.json.text }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Send",
                    "additionalFields": {
                      "callback_data": "=send:{{ $('New Lead (Tally)').item.json.body.data.submissionId }}"
                    }
                  },
                  {
                    "text": "✏️ Edit",
                    "additionalFields": {
                      "callback_data": "=edit:{{ $('New Lead (Tally)').item.json.body.data.submissionId }}"
                    }
                  },
                  {
                    "text": "❌ Reject",
                    "additionalFields": {
                      "callback_data": "=reject:{{ $('New Lead (Tally)').item.json.body.data.submissionId }}"
                    }
                  }
                ]
              }
            }
          ]
