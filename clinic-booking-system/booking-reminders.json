    {
      "parameters": {
        "jsCode": "const ALL_SLOTS = ['09:00','10:00','11:00','12:00','14:00','15:00','16:00','17:00'];\nconst trigger = $('Booking Form').item.json;\nconst bookedRows = $input.all().map(i => i.json).filter(r => r && r.appointmentDateTime);\nconst bookedTimesForDate = bookedRows.filter(r => (r.appointmentDateTime || '').startsWith(trigger.appointmentDate)).map(r => r.appointmentDateTime.split('T')[1].slice(0,5));\nconst availableSlots = ALL_SLOTS.filter(s => !bookedTimesForDate.includes(s));\nconst optionValues = availableSlots.length ? availableSlots.map(s => ({ option: s })) : [{ option: 'No slots available - go back and pick another date' }];\nconst formFieldsJson = { values: [{ fieldLabel: 'Preferred Time', fieldName: 'appointmentTime', fieldType: 'dropdown', requiredField: true, fieldOptions: { values: optionValues } }] };\nreturn [{ json: { ...trigger, formFieldsJson } }];"
      },
