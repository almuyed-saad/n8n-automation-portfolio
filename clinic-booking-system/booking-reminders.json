      "parameters": {
        "jsCode": "const selected = $input.first().json; const initial = $('Booking Form').item.json; let base = initial; try { const retryBase = $('Compute Retry Available Slots').item.json; if (retryBase && retryBase.formFieldsJson) base = retryBase; } catch (e) {} const item = { ...base, ...initial, ...selected }; let timeStr = (selected.appointmentTime || '').trim(); timeStr = timeStr.replace('.', ':'); if (!timeStr.includes(':') && timeStr.length === 4) timeStr = timeStr.slice(0, 2) + ':' + timeStr.slice(2); const parts = timeStr.split(':'); if (parts.length === 2) timeStr = parts[0].padStart(2, '0') + ':' + parts[1].padStart(2, '0'); const apptISO = item.appointmentDate + 'T' + timeStr + ':00'; const apptDate = new Date(apptISO); if (isNaN(apptDate.getTime())) throw new Error('Could not understand the time: ' + selected.appointmentTime + '. Please use format like 15:30.'); const remind24h = new Date(apptDate.getTime() - 24 * 60 * 60 * 1000); const remind1h = new Date(apptDate.getTime() - 60 * 60 * 1000); return [{ json: { ...item, appointmentTime: timeStr, appointmentDateTime: apptISO, remind24hISO: remind24h.toISOString(), remind1hISO: remind1h.toISOString() } }];"
      },
